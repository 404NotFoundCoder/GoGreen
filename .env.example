# 複製為 .env.local 並填入 Supabase 專案設定
# 請以 UTF-8 儲存（若在 Windows 另存為「Unicode」會變成 UTF-16，Next 讀不到變數）
# https://supabase.com/dashboard/project/_/settings/api
#
# ANON_KEY 請使用「Project API keys」區塊的 anon / public（長 JWT，通常以 eyJ 開頭）。
# 若儀表板只顯示 sb_publishable_ 開頭的新版金鑰，請在 API 頁面展開「Legacy」或「JWT」區塊複製 anon key，
# 或確認 @supabase/supabase-js 版本支援新版金鑰（若登入仍失敗，優先改用 JWT anon）。

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 正式站／Preview 建議設定（含 https，尾隨不要斜線），OAuth callback 302 與除錯用。
# Vercel：專案 Settings → Environment Variables 設為 https://你的域名.vercel.app 或自訂網域。
# Supabase Dashboard → Authentication → URL Configuration：
#   Site URL 設為同上（或主要正式網址）
#   Redirect URLs 必須包含「{SITE_URL}/auth/callback」與本機 http://localhost:3000/auth/callback（開發用）
NEXT_PUBLIC_SITE_URL=

# 僅限 server-side（Edge Function / 管理腳本），勿使用 NEXT_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=

# PWA 推播（選用，見 INSTRUCTIONS.md）
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_MAILTO=
